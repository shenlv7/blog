    .hc-pane.on { animation: none; }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('hc');
    if (!root) return;
    const reel = document.getElementById('hcReel');
    const consoleEl = document.getElementById('hcConsole');
    const spot = document.getElementById('hcSpot');
    if (!reel || !consoleEl) return;

    const items = Array.from(reel.querySelectorAll<HTMLElement>('.hc-item'));
    const panes = Array.from(root.querySelectorAll<HTMLElement>('.hc-pane'));
    const railIcons = Array.from(root.querySelectorAll<HTMLElement>('.hc-ri[data-i]'));
    const pathEl = root.querySelector<HTMLElement>('.hc-path');

    const PATHS = ['posts / ai-evolution', 'concepts / index', 'dev / index', 'shell / index'];
    const DUR = 5200;
    let idx = 0;
    let timer: number | null = null;
    let paused = false;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function paint(i: number) {
      items.forEach((el, k) => el.classList.toggle('act', k === i));
      panes.forEach((el, k) => el.classList.toggle('on', k === i));
      railIcons.forEach((el, k) => el.classList.toggle('on', k === i));
      if (pathEl) pathEl.textContent = PATHS[i] || '';
      items.forEach((el) => el.style.setProperty('--dur', DUR + 'ms'));
      const bar = items[i]?.querySelector<HTMLElement>('.hc-bar');
      if (bar) {
        bar.style.animation = 'none';
        void bar.offsetWidth;
        bar.style.animation = '';
      }
    }

    function go(i: number) {
      idx = (i + items.length) % items.length;
      paint(idx);
    }

    function stop() {
      if (timer) {
        window.clearInterval(timer);
        timer = null;
      }
    }

    function start() {
      stop();
      if (paused || reduce) return;
      timer = window.setInterval(() => go(idx + 1), DUR);
    }

    items.forEach((el, i) => {
      el.addEventListener('mouseenter', () => go(i));
      el.addEventListener('focus', () => go(i));
      el.addEventListener('mouseleave', () => start());
    });

    root.addEventListener('mouseenter', () => { paused = false; });
    root.addEventListener('mouseleave', () => { start(); });

    reel.addEventListener('mouseenter', () => { paused = true; stop(); });
    reel.addEventListener('mouseleave', () => { paused = false; start(); });
    reel.addEventListener('focusin', () => { paused = true; stop(); });
    reel.addEventListener('focusout', () => { paused = false; start(); });

    // 指针高光 + 面板 3D 微倾斜（有焦点含义，不做常驻动画）
    let raf: number | null = null;
    let px = 0;
    let py = 0;
    root.addEventListener('pointermove', (e) => {
      if (reduce) return;
      root.classList.add('ptr');
      const r = root.getBoundingClientRect();
      const sx = e.clientX - r.left;
      const sy = e.clientY - r.top;
      if (spot) spot.style.transform = `translate3d(${sx - 310}px, ${sy - 310}px, 0)`;
      const c = consoleEl.getBoundingClientRect();
      px = Math.max(-1, Math.min(1, (e.clientX - (c.left + c.width / 2)) / c.width));
      py = Math.max(-1, Math.min(1, (e.clientY - (c.top + c.height / 2)) / c.height));
      if (!raf) {
        raf = window.requestAnimationFrame(() => {
          raf = null;
          consoleEl.style.transform = `rotateX(${(-py * 3).toFixed(2)}deg) rotateY(${(px * 4).toFixed(2)}deg)`;
        });
      }
    }, { passive: true });
    root.addEventListener('pointerleave', () => {
      root.classList.remove('ptr');
      consoleEl.style.transform = '';
    });

    paint(0);
    start();
  })();
</script>
