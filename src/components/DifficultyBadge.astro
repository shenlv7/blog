---
const { difficulty } = Astro.props;
const levels = {
  beginner: { label: '入门', code: 'L1', color: '#34d399' },
  intermediate: { label: '中级', code: 'L2', color: '#f5a524' },
  advanced: { label: '进阶', code: 'L3', color: '#f43f5e' },
};
const level = levels[difficulty as keyof typeof levels] || levels.beginner;
---
<span
  class="difficulty-badge"
  style={`--badge-color: ${level.color}`}
  title={`难度: ${level.label}`}
>
  <em>{level.code}</em>{level.label}
</span>

<style>
  .difficulty-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--badge-color);
    border: 1px solid color-mix(in srgb, var(--badge-color) 45%, transparent);
    background: color-mix(in srgb, var(--badge-color) 10%, transparent);
    border-radius: 3px;
    padding: 0.08rem 0.42rem;
    white-space: nowrap;
  }
  .difficulty-badge em {
    font-family: var(--mono);
    font-style: normal;
    font-size: 0.62rem;
    opacity: 0.75;
  }
</style>
