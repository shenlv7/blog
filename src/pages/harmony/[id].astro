---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('harmony');
  return items.map(item => ({
    params: { id: item.id.replace(/\.md$/, '') },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const base = import.meta.env.BASE_URL || '/';
const all = await getCollection('harmony');
const track = item.data.track;
const siblings = all.filter(i => i.data.track === track).sort((a, b) => a.data.order - b.data.order);
const pos = siblings.findIndex(i => i.id === item.id);
const prev = pos > 0 ? siblings[pos - 1] : null;
const next = pos >= 0 && pos < siblings.length - 1 ? siblings[pos + 1] : null;
const trackName = track === 'course' ? '实战 12 讲' : '小白指南';
const unit = track === 'course' ? '讲' : '章';
---

<Base title={`${item.data.title} — 鸿蒙开发学习`} description={item.data.description}>
  <article class="post-article">
    <header class="post-header">
      <div class="track-badge">
        <a href={`${base}harmony/`}>{trackName}</a>
        <span>·</span>
        <span>第 {item.data.order} {unit}</span>
        <span>/ 共 {siblings.length} {unit}</span>
      </div>
      <h1>{item.data.title}</h1>
      <p class="post-description">{item.data.description}</p>
      <div class="post-meta">
        <time>{item.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        <span class="read-time">约 {item.data.minutes} 分钟</span>
      </div>
      {item.data.tags && item.data.tags.length > 0 && (
        <div class="post-tags">
          {item.data.tags.map(tag => <span class="post-tag">{tag}</span>)}
        </div>
      )}
    </header>

    <div class="post-content">
      <Content />
    </div>

    <footer class="post-footer">
      <nav class="lecture-nav">
        {prev ? (
          <a class="lecture-link prev" href={`${base}harmony/${prev.id.replace(/\.md$/, '')}/`}>
            <span class="lk">← 上一{unit}</span>
            <span class="lt">{prev.data.title}</span>
          </a>
        ) : <span />}
        {next ? (
          <a class="lecture-link next" href={`${base}harmony/${next.id.replace(/\.md$/, '')}/`}>
            <span class="lk">下一{unit} →</span>
            <span class="lt">{next.data.title}</span>
          </a>
        ) : <span />}
      </nav>
      <div class="back-link-wrap">
        <a href={`${base}harmony/`} class="back-link">← 返回鸿蒙开发学习</a>
      </div>
    </footer>
  </article>
</Base>

<style>

  .post-article { max-width: 800px; margin: 0 auto; }
  
  /* 文章头必须随正文滚走：别让任何全局 header 规则把它粘住 */
  .post-header {
    position: static !important;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .series-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--accent);
    margin-bottom: 0.8rem;
    padding: 0.3rem 0.8rem;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    border-radius: 100px;
  }
  .series-badge a { color: var(--accent); text-decoration: none; font-weight: 600; }
  .series-badge a:hover { text-decoration: underline; }
  .series-badge span { color: var(--muted); }
  
  .post-header h1 { font-size: 2rem; line-height: 1.3; margin-bottom: 0.75rem; color: var(--text); }
  .post-description { font-size: 1.05rem; color: var(--muted); line-height: 1.5; margin-bottom: 1rem; }
  
  .post-meta { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.8rem; color: var(--muted); font-size: 0.9rem; }
  .diff-badge {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
    font-weight: 500;
  }
  .diff-beginner { background: rgba(16, 185, 129, 0.1); color: #10b981; }
  .diff-intermediate { background: rgba(245, 158, 11, 0.1); color: #f59e0b; }
  .diff-advanced { background: rgba(239, 68, 68, 0.1); color: #ef4444; }
  
  .post-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .post-tag { background: var(--accent); color: white; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.85rem; text-decoration: none; transition: all 0.2s; }
  .post-tag:hover { background: var(--accent-light); transform: scale(1.05); }

  /* ---- 正文排版 v2：为毛玻璃背景重做层级 ---- */
  .post-article { max-width: 760px; margin: 0 auto; }

  .post-content {
    font-size: 1.02rem;
    line-height: 1.85;
    color: var(--text);
    /* 中文正文 45-50 字/行的可读区间 */
    letter-spacing: 0.005em;
  }

  /* h2：左侧一道青色短划标出章节起点，替代原来的粗底线 */
  .post-content :global(h2) {
    position: relative;
    font-size: 1.42rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    margin: 2.8rem 0 1.1rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--border);
  }
  .post-content :global(h2)::before {
    content: '';
    position: absolute;
    left: 0; bottom: -1px;
    width: 46px; height: 2px;
    background: linear-gradient(90deg, var(--accent), rgba(34, 211, 238, 0.15));
  }
  .post-content :global(h3) {
    font-size: 1.16rem;
    font-weight: 600;
    margin: 2rem 0 0.7rem;
    color: var(--text);
  }
  .post-content :global(h4) {
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 1.7rem 0 0.5rem;
  }

  .post-content :global(p) { margin: 1rem 0; }
  .post-content :global(ul),
  .post-content :global(ol) { margin: 1rem 0; padding-left: 1.5rem; }
  .post-content :global(li) { margin: 0.45rem 0; }
  .post-content :global(li)::marker { color: var(--accent); }

  /* 引文：细竖线 + 极淡底，不用粗红边 */
  .post-content :global(blockquote) {
    border-left: 2px solid var(--accent);
    background: rgba(34, 211, 238, 0.045);
    padding: 1rem 1.3rem;
    margin: 1.7rem 0;
    border-radius: 0 10px 10px 0;
    color: var(--text-dim);
  }
  .post-content :global(blockquote p) { margin: 0; font-style: normal; }
  .post-content :global(blockquote strong) { color: var(--text); }

  /* 代码：玻璃卡片式，顶部一道极淡描边 */
  .post-content :global(pre) {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.15rem 1.25rem;
    overflow-x: auto;
    margin: 1.6rem 0;
    font-size: 0.86rem;
    line-height: 1.65;
    font-family: var(--mono);
  }
  .post-content :global(:not(pre) > code) {
    background: rgba(34, 211, 238, 0.08);
    border: 1px solid rgba(34, 211, 238, 0.16);
    color: #8fe6f5;
    padding: 0.1rem 0.38rem;
    border-radius: 4px;
    font-size: 0.86em;
    font-family: var(--mono);
  }
  .post-content :global(pre code) { background: none; border: none; padding: 0; color: inherit; }

  .post-content :global(img) {
    max-width: 100%; height: auto;
    border-radius: 10px;
    border: 1px solid var(--border);
    margin: 1.6rem 0;
  }

  .post-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: rgba(34, 211, 238, 0.45);
  }
  .post-content :global(a:hover) { text-decoration-color: var(--accent); }

  .post-content :global(strong) { color: #fff; font-weight: 650; }

  .post-content :global(hr) {
    border: none;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-hi), transparent);
    margin: 2.5rem 0;
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.6rem 0;
    font-size: 0.88rem;
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .post-content :global(th),
  .post-content :global(td) {
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }
  .post-content :global(th) {
    background: var(--panel-2);
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  .post-content :global(tr:last-child td) { border-bottom: none; }

  .post-footer { margin-top: 3rem; }

  .related-posts { margin-top: 3rem; }
  .related-posts h3 { font-size: 1.2rem; margin-bottom: 1rem; color: var(--text); }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
  .related-item { display: block; padding: 1rem; background: var(--card-bg); border: 1px solid var(--border); border-radius: 8px; text-decoration: none; transition: all 0.2s; }
  .related-item:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .related-item h4 { color: var(--text); margin-bottom: 0.4rem; font-size: 0.95rem; }
  .related-item p { color: var(--muted); font-size: 0.85rem; margin: 0; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  
  .share-section { margin-top: 3rem; }
  .share-section h3 { font-size: 1.2rem; margin-bottom: 1rem; color: var(--text); }
  .share-buttons { display: flex; gap: 0.75rem; }
  .share-btn { padding: 0.5rem 1rem; border: 1.5px solid var(--border); border-radius: 8px; background: var(--card-bg); color: var(--text); cursor: pointer; font-size: 0.9rem; text-decoration: none; transition: all 0.2s; }
  .share-btn:hover { border-color: var(--accent); color: var(--accent); }
  .share-btn.twitter:hover { background: #1da1f2; color: white; border-color: #1da1f2; }
  
  .back-link-wrap { margin-top: 2rem; text-align: center; }
  .back-link { color: var(--muted); text-decoration: none; font-size: 0.9rem; }
  .back-link:hover { color: var(--accent); }

  @media (max-width: 768px) {
    /* 手机端标题卡片压缩：让正文更快进入视野 */
    .post-header { margin-bottom: 1.25rem; padding-bottom: 1rem; }
    .series-badge { font-size: 0.72rem; padding: 0.22rem 0.6rem; margin-bottom: 0.5rem; }
    .post-header h1 { font-size: 1.35rem; line-height: 1.35; margin-bottom: 0.5rem; }
    .post-description { font-size: 0.92rem; line-height: 1.45; margin-bottom: 0.7rem;
      display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .post-meta { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.7rem; margin-bottom: 0.55rem; font-size: 0.82rem; }
    /* tags 横向滑动，不换行堆叠 */
    .post-tags { flex-wrap: nowrap; overflow-x: auto; gap: 0.4rem; padding-bottom: 0.2rem;
      -webkit-overflow-scrolling: touch; scrollbar-width: none; }
    .post-tags::-webkit-scrollbar { display: none; }
    .post-tag { flex-shrink: 0; font-size: 0.78rem; padding: 0.22rem 0.6rem; }
    .post-content { font-size: 0.98rem; line-height: 1.8; }
    .post-content :global(h2) { font-size: 1.24rem; margin: 2rem 0 0.8rem; }
    .post-content :global(h3) { font-size: 1.12rem; margin: 1.4rem 0 0.6rem; }
    .post-content :global(pre) { padding: 1rem; font-size: 0.82rem; border-radius: 6px; }
    .post-content :global(table) { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; font-size: 0.85rem; }
    .share-buttons { flex-direction: column; }
    .related-grid { grid-template-columns: 1fr; }
  }


  .track-badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.04em;
    color: var(--accent); margin-bottom: 0.9rem;
    padding: 0.28rem 0.75rem;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    border-radius: 100px;
  }
  .track-badge a { color: var(--accent); text-decoration: none; font-weight: 600; }
  .track-badge span { color: var(--muted); }
  .read-time { font-family: var(--mono); font-size: 0.82rem; color: var(--muted); }
  .post-tag { cursor: default; }

  .lecture-nav {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
    margin: 3rem 0 1.5rem;
  }
  .lecture-link {
    display: flex; flex-direction: column; gap: 0.35rem;
    padding: 1rem 1.15rem; text-decoration: none;
    background: var(--panel); border: 1px solid var(--border);
    border-radius: 10px; transition: all 0.25s var(--ease);
  }
  .lecture-link:hover { border-color: var(--glass-border-hi); transform: translateY(-2px); }
  .lecture-link.next { text-align: right; }
  .lecture-link .lk { font-family: var(--mono); font-size: 0.76rem; color: var(--accent); }
  .lecture-link .lt { color: var(--text-dim); font-size: 0.92rem; line-height: 1.5; }
  @media (max-width: 640px) { .lecture-nav { grid-template-columns: 1fr; } }
</style>
