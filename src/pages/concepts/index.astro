---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { CONCEPT_GROUPS } from '../../data/concept-groups';

const allPosts = await getCollection('posts');
const base = '/blog/';

// 只算编号卡片：系列索引页（ai-concepts-study-path）也带 series，但不该计入篇数
const conceptPosts = allPosts
  .filter(p => p.data.series === 'ai-concepts' && p.data.seriesOrder)
  .sort((a, b) => (a.data.seriesOrder || 0) - (b.data.seriesOrder || 0));

const byNum = new Map(conceptPosts.map(p => [p.data.seriesOrder as number, p]));
const groupedNums = new Set(CONCEPT_GROUPS.flatMap(g => g.nums));
const ungrouped = conceptPosts.filter(p => !groupedNums.has(p.data.seriesOrder as number));

const groups = CONCEPT_GROUPS.map(g => ({
  ...g,
  posts: g.nums.map(n => byNum.get(n)).filter(Boolean) as typeof conceptPosts,
}));

const total = conceptPosts.length;
const demoCount = conceptPosts.filter(p =>
  (p.body || '').includes('github.com/shenlv7/blog/blob/main/demos/')
).length;
const codeCount = conceptPosts.filter(p => /```(python|py)/.test(p.body || '')).length;

const difficultyConfig: Record<string, { label: string; color: string; bg: string }> = {
  beginner: { label: '入门', color: '#10b981', bg: 'rgba(16, 185, 129, 0.1)' },
  intermediate: { label: '进阶', color: '#f59e0b', bg: 'rgba(245, 158, 11, 0.1)' },
  advanced: { label: '高级', color: '#ef4444', bg: 'rgba(239, 68, 68, 0.1)' },
};

function estimateReadingTime(content: string): number {
  const chineseChars = (content.match(/[\u4e00-\u9fff]/g) || []).length;
  const englishWords = content.replace(/[\u4e00-\u9fff]/g, '').match(/\b\w+\b/g)?.length || 0;
  return Math.ceil(chineseChars / 450 + englishWords / 200);
}

const avgMinutes = total
  ? Math.round(conceptPosts.reduce((s, p) => s + estimateReadingTime(p.body || ''), 0) / total)
  : 0;

function hasPublicDemo(body: string) {
  return body.includes('github.com/shenlv7/blog/blob/main/demos/');
}
---

<Base
  title={`AI 核心概念 · ${total} 篇机制笔记与可运行代码 | 赛博阿漆`}
  description={`${total} 篇 AI 核心概念卡片，按 8 个主题分组：从 Prompt、Embedding 到 KV Cache、MoE、量化与评测。每篇给出可复现实验与真实输出。`}
>
  <div class="concepts-page">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-badge">// 技术深度向</div>
      <h1>AI核心概念</h1>
      <p class="hero-desc">
        {total} 篇机制笔记，按 {groups.length} 个主题分组。不只是"是什么"，而是把它拆到能自己写一遍。<br />
        {codeCount} 篇附可复现代码；<a href={`${base}concepts/graph/`}>概念图谱 →</a> · <a href={`${base}posts/ai-concepts-study-path/`}>学习路径 →</a>
      </p>

      <div class="hero-stats">
        <div class="stat-item">
          <span class="stat-num">{total}</span>
          <span class="stat-label">已发布</span>
        </div>
        <div class="stat-item">
          <span class="stat-num">{groups.length}</span>
          <span class="stat-label">主题分组</span>
        </div>
        <div class="stat-item">
          <span class="stat-num">{avgMinutes}</span>
          <span class="stat-label">单篇均读(分钟)</span>
        </div>
      </div>
    </section>

    {groups.map(group => (
      <section class="category-section">
        <div class="category-header" style={`border-left: 4px solid ${group.color}`}>
          <div class="category-title">
            <span class="cat-emoji">{group.key}</span>
            <h2>{group.name}</h2>
            <span class="cat-count" style={`background: ${group.color}`}>{group.posts.length} 篇</span>
          </div>
          <p class="cat-desc">{group.desc}</p>
        </div>
        {group.posts.length > 0 ? (
          <div class="concepts-grid">
            {group.posts.map(post => {
              const slug = post.id.replace(/\.md$/, '');
              const diff = post.data.difficulty || 'beginner';
              const diffInfo = difficultyConfig[diff] || difficultyConfig.beginner;
              const readTime = estimateReadingTime(post.body || '');
              return (
                <article class="concept-card">
                  <div class="card-top">
                    <span class="card-number" style={`background: ${group.color}`}>
                      {String(post.data.seriesOrder).padStart(2, '0')}
                    </span>
                    <span class="card-difficulty" style={`color: ${diffInfo.color}; background: ${diffInfo.bg}`}>
                      {diffInfo.label}
                    </span>
                  </div>
                  <h3>
                    <a href={`${base}posts/${slug}/`}>{post.data.title.replace(/^\d+\s*\|\s*/, '')}</a>
                  </h3>
                  <p class="card-desc">{post.data.description}</p>
                  <div class="card-footer">
                    <span class="card-time">{readTime} 分钟</span>
                    <a href={`${base}posts/${slug}/`} class="card-link">
                      {hasPublicDemo(post.body || '') ? '阅读 + 公开脚本 →' : '阅读全文 →'}
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="empty-category"><p>该分组撰写中。</p></div>
        )}
      </section>
    ))}

    {ungrouped.length > 0 && (
      <section class="category-section">
        <div class="category-header" style="border-left: 4px solid var(--muted)">
          <div class="category-title">
            <span class="cat-emoji">NEW</span>
            <h2>新近发布 · 待归类</h2>
            <span class="cat-count">{ungrouped.length} 篇</span>
          </div>
          <p class="cat-desc">已发布但还没加进主题分组，编号照样可读</p>
        </div>
        <div class="concepts-grid">
          {[...ungrouped].reverse().map(post => {
            const slug = post.id.replace(/\.md$/, '');
            const diffInfo = difficultyConfig[post.data.difficulty || 'beginner'] || difficultyConfig.beginner;
            return (
              <article class="concept-card">
                <div class="card-top">
                  <span class="card-number">{String(post.data.seriesOrder).padStart(2, '0')}</span>
                  <span class="card-difficulty" style={`color: ${diffInfo.color}; background: ${diffInfo.bg}`}>
                    {diffInfo.label}
                  </span>
                </div>
                <h3><a href={`${base}posts/${slug}/`}>{post.data.title.replace(/^\d+\s*\|\s*/, '')}</a></h3>
                <p class="card-desc">{post.data.description}</p>
                <div class="card-footer">
                  <span class="card-time">{estimateReadingTime(post.body || '')} 分钟</span>
                  <a href={`${base}posts/${slug}/`} class="card-link">阅读全文 →</a>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    <!-- 学习建议 -->
    <section class="cta-section">
      <h2>💡 学习建议</h2>
      <div class="tips-grid">
        <div class="tip-card">
          <span class="tip-emoji">🟢</span>
          <h3>入门读者</h3>
          <p>从 A 组开始按顺序读。每篇都能独立跑，动手跑一遍效果翻倍。</p>
        </div>
        <div class="tip-card">
          <span class="tip-emoji">🟡</span>
          <h3>有经验的开发者</h3>
          <p>直接跳到感兴趣的分组。D 组讲推理成本，E 组讲训练与对齐。</p>
        </div>
        <div class="tip-card">
          <span class="tip-emoji">🔴</span>
          <h3>想深入原理</h3>
          <p>读 C 组再进 D / E / G；三条推荐路线在<a href={`${base}posts/ai-concepts-study-path/`}>学习路径</a>里。</p>
        </div>
      </div>
      <p class="demo-honest">已发布 {total} 篇，其中 {demoCount} 篇的完整脚本公开在仓库 demos/；其余为文内可复现片段。</p>
    </section>
  </div>
</Base>

<style>
  .concepts-page { max-width: 1100px; margin: 0 auto; }

  .hero {
    text-align: center;
    padding: 3rem 2rem;
    background: linear-gradient(135deg, var(--card-bg), var(--border));
    border-radius: 16px;
    margin-bottom: 3rem;
  }
  .hero-badge {
    display: inline-block;
    background: var(--accent);
    color: white;
    padding: 0.3rem 1rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .hero h1 { font-size: 2.8rem; margin-bottom: 0.8rem; }
  .hero-desc { color: var(--muted); font-size: 1.1rem; line-height: 1.6; margin-bottom: 2rem; }
  .hero-desc a { color: var(--accent); }

  .hero-stats { display: flex; justify-content: center; gap: 3rem; }
  .stat-item { text-align: center; }
  .stat-num { display: block; font-size: 1.8rem; font-weight: 700; color: var(--accent); }
  .stat-label { font-size: 0.85rem; color: var(--muted); }

  .category-section { margin-bottom: 3rem; }
  .category-header {
    padding: 1rem 1.5rem;
    margin-bottom: 1.5rem;
    background: var(--card-bg);
    border-radius: 0 12px 12px 0;
  }
  .category-title { display: flex; align-items: center; gap: 0.75rem; }
  .cat-emoji { font-size: 1.1rem; font-weight: 700; color: var(--muted); font-family: monospace; }
  .category-title h2 { font-size: 1.5rem; margin: 0; }
  .cat-count {
    background: var(--accent);
    color: white;
    padding: 0.15rem 0.6rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .cat-desc { color: var(--muted); margin: 0.3rem 0 0 0; font-size: 0.95rem; }

  .concepts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
  }
  .concept-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    transition: all 0.2s;
  }
  .concept-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.8rem;
  }
  .card-number {
    background: var(--border-hi);
    color: white;
    padding: 0.2rem 0.7rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .card-difficulty {
    padding: 0.15rem 0.6rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .concept-card h3 { font-size: 1.15rem; margin-bottom: 0.5rem; line-height: 1.45; }
  .concept-card h3 a { color: var(--text); text-decoration: none; }
  .concept-card h3 a:hover { color: var(--accent); }
  .card-desc {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .card-time { font-size: 0.8rem; color: var(--muted); }
  .card-link { color: var(--accent); font-weight: 500; font-size: 0.9rem; }
  .card-link:hover { text-decoration: underline; }

  .empty-category {
    text-align: center;
    padding: 2rem;
    background: var(--card-bg);
    border: 1px dashed var(--border);
    border-radius: 12px;
    color: var(--muted);
  }

  .cta-section {
    margin-top: 3rem;
    padding: 2rem;
    background: var(--card-bg);
    border-radius: 16px;
    border: 1px solid var(--border);
  }
  .cta-section h2 { text-align: center; margin-bottom: 2rem; }
  .tips-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; }
  .tip-card {
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    text-align: center;
  }
  .tip-emoji { font-size: 2rem; display: block; margin-bottom: 0.8rem; }
  .tip-card h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }
  .tip-card p { color: var(--muted); font-size: 0.9rem; line-height: 1.5; }
  .tip-card a { color: var(--accent); }
  .demo-honest {
    margin: 2rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .hero h1 { font-size: 2rem; }
    .hero-stats { gap: 2rem; }
    .concepts-grid { grid-template-columns: 1fr; }
    .tips-grid { grid-template-columns: 1fr; }
  }
</style>
